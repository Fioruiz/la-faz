# Cadena de conexión *pooled* de Neon. Copiar este archivo a .env.local y completar.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST/BASE?sslmode=require
DATABASE_URL=
# Cadena de conexión directa (sin pooler) de Neon; la usan las migraciones (db:migrate).
DATABASE_URL_UNPOOLED=
# Cadena de la rama de pruebas de Neon (test-esquema). Va en .env.test, nunca la de producción.
DATABASE_URL_TEST=

# Secreto con el que Auth.js firma la sesión. Generar con: openssl rand -base64 32
# Distinto en local y en Vercel.
AUTH_SECRET=

# Responsable inicial: los lee solo `npm run db:seed-responsable`. Contraseña de al menos 12 caracteres.
# Quitar la contraseña de .env.local después de crear el responsable.
RESPONSABLE_INICIAL_NOMBRE=
RESPONSABLE_INICIAL_CORREO=
RESPONSABLE_INICIAL_PASSWORD=

# Rol de solo lectura de la zona pública (ADR 0011). La contraseña la lee solo `npm run db:rol-publico`.
# Cadena *pooled* del rol publico_lectura: la usa la zona pública (obligatoria al desplegar).
DATABASE_URL_PUBLICO=
PUBLICO_LECTURA_PASSWORD=
# Cadena del mismo rol en la rama de pruebas (va en .env.test).
DATABASE_URL_TEST_PUBLICO=
